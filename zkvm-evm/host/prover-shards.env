# Настройки прувера SP1 на процессоре для машины с 16 ГБ памяти (PROVING.md → «Пруф блока EVM
# для контракта»): шарды в шесть раз меньше стандартных и по одному рабочему на этап
# (bench/evm-rsp-cycles.json). С настройками SP1 по умолчанию прувер не помещается в 16 ГБ.
#
# Один файл на всех: сервис-секвенсор (sequencer/prover.ts, LocalProver) передаёт эти переменные
# zkvm-evm/host/prove-guarded.sh, а zkvm-evm/host/remote/measure.sh — этапам на процессоре.
# Формат — строки ИМЯ=значение без кавычек и пробелов (читают и bash, и TypeScript).
ELEMENT_THRESHOLD=67108864
HEIGHT_THRESHOLD=1048576
SP1_WORKER_NUM_CORE_WORKERS=1
SP1_WORKER_CORE_BUFFER_SIZE=1
SP1_WORKER_NUM_SPLICING_WORKERS=1
SP1_WORKER_SPLICING_BUFFER_SIZE=1
SP1_WORKER_NUM_SETUP_WORKERS=1
SP1_WORKER_NUM_RECURSION_PROVER_WORKERS=1
SP1_WORKER_NUM_RECURSION_EXECUTOR_WORKERS=1
SP1_WORKER_NUM_PREPARE_REDUCE_WORKERS=1
SP1_WORKER_NUM_DEFERRED_WORKERS=1

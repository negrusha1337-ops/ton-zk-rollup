pragma circom 2.2.2;

// Синтетическая схема для бенчмарка газа: N публичных входов.
// Стоимость Groth16-верификации в TVM зависит только от числа публичных
// сигналов (размер суммы IC0 + sum(pub[i] * IC[i+1])), а не от того, что
// именно схема доказывает. Поэтому утверждение здесь намеренно игрушечное:
// «я знаю k, для которого prod[i] = pub[i] * k» — этого достаточно, чтобы
// каждый публичный вход участвовал в ограничениях.
template PubInputs(N) {
    signal input pub[N]; // публичные (объявлены в main)
    signal input k;      // приватный свидетель
    signal prod[N];

    for (var i = 0; i < N; i++) {
        prod[i] <== pub[i] * k;
    }
}

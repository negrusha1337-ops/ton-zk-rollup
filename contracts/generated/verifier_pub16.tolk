// СГЕНЕРИРОВАНО: npm run zk:verifiers. Не править руками.

import "@stdlib/exotic-cells"

contract Verifier {
  description: "Groth16 verifier generated by export-ton-verifier"
  storage: VerifierStorage
  incomingMessages: Verify
}

/// This verifier is stateless.
/// It does not provide:
/// - nullifier replay protection;
/// - nonce or query-id protection;
/// - known-root validation;
/// - recipient binding;
/// - chain-id or contract-address domain separation;
/// - state-transition validation.

/// Empty persistent storage; verifier constants are embedded in code.
struct VerifierStorage {}

// IC0 is the constant term
const IC0: slice = "b95d07ac1b17e5ad5d2defc8779c81643a89a5c6d2e4aa90d7845e92454d98fec64afaa69f7571a269aa2b8edba36cc4".hexToSlice()

const VK_GAMMA_2: slice = "93e02b6052719f607dacd3a088274f65596bd0d09920b61ab5da61bbdc7f5049334cf11213945d57e5ac7d055d042b7e024aa2b2f08f0a91260805272dc51051c6e47ad4fa403b02b4510b647ae3d1770bac0326a805bbefd48056c8c121bdb8".hexToSlice()
const VK_DELTA_2: slice = "b78df3020ce4c69c3964f6d5a42084d62984de3a5bd0ce65709f56cca520b0114876ded5d66cce780150bc2e6aee8daf0584fc2b93f2a28303f752349f42a111f8d64f4ff86ba7116b6ddbdc115f99d25125217d996f7a6ad4a35ad6798da586".hexToSlice()
const VK_ALPHA_1: slice = "b69ef7f2f996e2cbc09a68777ba16d5f1d6ded1cfac162a2b9198d03411c9a8f2728e1a8e1a5dd575bc763f2b7d80e02".hexToSlice()
const VK_BETA_2:  slice = "86a7a81f24addbcedbe8d590cfafd566e84f6cc45b22f09f10429b500681c96bec491388271432bddb070b5a9d760e500bdb5c6caef3d8ee4c9656203b6e26bf635f96184c70d3c0f4fe81f3f3e480a7710c019ae5b2b956778991dd7c58dd39".hexToSlice()

const N_PUBLIC: int = 16

const MIN_VERIFY_VALUE: coins = 50000000

enum VerifierErrors {
  InvalidInputs = 258,
  IndexOutOfRange = 259,
  WrongProof = 260,
  NotEnoughValue = 261,
}


/// # Safety
/// Expects both slices to contain canonically encoded BLS12-381 G1 points
/// accepted by the TVM `BLS_G1_ADD` opcode.
@pure fun blsG1Add(x: slice, y: slice): slice asm "BLS_G1_ADD";

/// # Safety
/// Expects the slice to contain a canonically encoded BLS12-381 G1 point
/// accepted by the TVM `BLS_G1_NEG` opcode.
@pure fun blsG1Neg(x: slice): slice asm "BLS_G1_NEG";

@pure fun blsG1InGroup(x: slice): bool asm "BLS_G1_INGROUP";
@pure fun blsG2InGroup(x: slice): bool asm "BLS_G2_INGROUP";
@pure fun blsG1IsZero(x: slice): bool asm "BLS_G1_ISZERO";
@pure fun blsG2IsZero(x: slice): bool asm "BLS_G2_ISZERO";

fun checkProofPoints(piA: slice, piB: slice, piC: slice) {
  if (
    piA.remainingBitsCount() != 384 || piA.remainingRefsCount() != 0 ||
    piB.remainingBitsCount() != 768 || piB.remainingRefsCount() != 0 ||
    piC.remainingBitsCount() != 384 || piC.remainingRefsCount() != 0
  ) {
    throw VerifierErrors.InvalidInputs;
  }
  if (!blsG1InGroup(piA) || !blsG2InGroup(piB) || !blsG1InGroup(piC)) {
    throw VerifierErrors.InvalidInputs;
  }
  if (blsG1IsZero(piA) || blsG2IsZero(piB) || blsG1IsZero(piC)) {
    throw VerifierErrors.InvalidInputs;
  }
}

fun loadCheckedG1(point: cell): slice {
  val (pointSlice, isExotic) = point.beginParseSpecial();
  if (isExotic || pointSlice.remainingBitsCount() != 384 || pointSlice.remainingRefsCount() != 0) {
    throw VerifierErrors.InvalidInputs;
  }
  return pointSlice;
}

fun loadCheckedG2(point: cell): slice {
  val (pointSlice, isExotic) = point.beginParseSpecial();
  if (isExotic || pointSlice.remainingBitsCount() != 768 || pointSlice.remainingRefsCount() != 0) {
    throw VerifierErrors.InvalidInputs;
  }
  return pointSlice;
}

fun loadCheckedProof(proof: cell): (slice, slice, slice) {
  val (initialProof, isExotic) = proof.beginParseSpecial();
  var proofSlice = initialProof;
  if (isExotic || proofSlice.remainingBitsCount() != 0 || proofSlice.remainingRefsCount() != 3) {
    throw VerifierErrors.InvalidInputs;
  }
  val piA = loadCheckedG1(proofSlice.loadRef());
  val piB = loadCheckedG2(proofSlice.loadRef());
  val piC = loadCheckedG1(proofSlice.loadRef());
  proofSlice.assertEnd();
  return (piA, piB, piC);
}

@pure fun blsR(): int asm "BLS_PUSHR";

fun checkPublicInput(x: int): int {
  // TVM scalar multiplication reduces modulo r, so x and x+r would otherwise alias.
  if (x < 0 || x >= blsR()) {
    throw VerifierErrors.InvalidInputs;
  }
  return x;
}

/// # Safety
/// Expects the provided slices to contain canonically encoded BLS12-381 proof
/// and verification-key points in the order required by TVM `BLS_PAIRING`.
@pure fun blsPairing(
  x1: slice, y1: slice,
  x2: slice, y2: slice,
  x3: slice, y3: slice,
  x4: slice, y4: slice,
  n: int
): int asm "BLS_PAIRING";

/// # Safety
/// Expects x1..x7 to be canonical BLS12-381 G1 points and y1..y7
/// to be scalars encoded in the format expected by TVM `BLS_G1_MULTIEXP`.
@pure
fun blsG1Multiexp7(
  x1: slice, y1: int,
  x2: slice, y2: int,
  x3: slice, y3: int,
  x4: slice, y4: int,
  x5: slice, y5: int,
  x6: slice, y6: int,
  x7: slice, y7: int,
  n: int
): slice asm "BLS_G1_MULTIEXP";

/// # Safety
/// Expects x1..x2 to be canonical BLS12-381 G1 points and y1..y2
/// to be scalars encoded in the format expected by TVM `BLS_G1_MULTIEXP`.
@pure
fun blsG1Multiexp2(
  x1: slice, y1: int,
  x2: slice, y2: int,
  n: int
): slice asm "BLS_G1_MULTIEXP";

// IC selector for runtime batching. The points are inlined to avoid emitting IC1..ICN constants.
fun ic(idx: int): slice {
  if (idx == 1) { return "871647944124506779b2a4a0b00b7487665b468b1bdc4276551c4847e133bd46f6162b5fc72907f58addc01d6b9adde0".hexToSlice(); }
  if (idx == 2) { return "8d54e2f8679a71b82ed3e53d38ea27ed995ab7e6bdacae6e21c1a268b2c6b2a654dcc65a6fbb5d1a31ebf00b5cc97085".hexToSlice(); }
  if (idx == 3) { return "b8099824ccd7e5864267bed03e93c65818de09da9c33e38699410fc17d63be6d392c0d9d88471e4dcef631a66c485674".hexToSlice(); }
  if (idx == 4) { return "a0a34b4c0a90aa5fcd0a79a50edfcc926a2209e887085dd64c87c161e79f01fda9e91e765f8b58b9c4b09e86330a7120".hexToSlice(); }
  if (idx == 5) { return "89ab936997f6a614a6a1f94a24b0340437ae17187468b993c3c3d33cfcbe6570a6f060d045878c0eeb3b513d2df22bbb".hexToSlice(); }
  if (idx == 6) { return "a818b39855f7428d776dbd8c91b90a09bd3d93e9859231848dfc405f7158ebd2393d8b5aa8e30172745ded17cff0b55c".hexToSlice(); }
  if (idx == 7) { return "a53e32f87abee1c5c27482d05580135063c84a18fd9584d36a1306411a8a42cc33bacfb45dc3c9ff0f42adbe3b98bb2a".hexToSlice(); }
  if (idx == 8) { return "9026d52c7e6327d496727ce99a0afba3d307ab891f0e5ec220b54844cb8f3bf2181fad150b1cebeb1d7d97d1b0da94d8".hexToSlice(); }
  if (idx == 9) { return "88e7012062925583999dd26b05432caf53f166e66db22ae7475417c011850377040ca86165e2390191410b05da882f23".hexToSlice(); }
  if (idx == 10) { return "b753a7bae602d2d4ebf5afce9b9b89a413a111f54c1b4389afb2c92010d06eb2c082fd01ad3054e3f3af28e2177a18ec".hexToSlice(); }
  if (idx == 11) { return "9279bb273c19c01aeeb179cb7530b4eb9f7a2705d3ef00f56c8afb94b0e8f590a6438012b005ab9563eab5b3a6a2181b".hexToSlice(); }
  if (idx == 12) { return "a3d739da9167794c33bd3b073472046639330711c856e16e3dd7adbb1e26f1bf7d436c7b0bdb9c4fd8bf640e697af14c".hexToSlice(); }
  if (idx == 13) { return "83cb76c6d46db7ee2aa9c1f2e855d26fd317c9f6295dea0e7eb246e53f0133e66319965a726006e8bbfafac5f8cbc2d9".hexToSlice(); }
  if (idx == 14) { return "b9dc2b71f1184025ce01164571bf179cdc995480d51a6737d842d9e166386153e5538d6ccac80dc7d00598146440364c".hexToSlice(); }
  if (idx == 15) { return "aeb39d2e416977350ac3a82317f50b6d0c139ca67f42439d90eebe01efaa0df9480c5a1eab62dcbce058094b52b37ced".hexToSlice(); }
  if (idx == 16) { return "adeb3fd3d02e1076811e876426b179e0bcb526aaf8cb109450b4c2342738b85c1d90a7c320363d8eaa1dbe971e76206d".hexToSlice(); }
  throw VerifierErrors.IndexOutOfRange;
}

// Internal messages carry public inputs as a custom payload:
// uint8 length, then canonical three-int257 chunks chained through refs.
fun checkPublicInputsPayloadShape(payload: slice) {
  var remaining: int = 16;

  while (remaining > 0) {
    var chunk: int = remaining;
    if (chunk > 3) { chunk = 3; }
    if (payload.remainingBitsCount() != chunk * 257) { throw VerifierErrors.InvalidInputs; }
    remaining -= chunk;

    if (remaining > 0) {
      if (payload.remainingRefsCount() != 1) { throw VerifierErrors.InvalidInputs; }
      val (nextPayload, isExotic) = payload.loadRef().beginParseSpecial();
      if (isExotic) { throw VerifierErrors.InvalidInputs; }
      payload = nextPayload;
    } else if (payload.remainingRefsCount() != 0) {
      throw VerifierErrors.InvalidInputs;
    }
  }
}

fun loadNextPubInput(mutate payload: slice): int {
  if (payload.remainingBitsCount() < 257) {
    if (payload.remainingBitsCount() != 0 || payload.remainingRefsCount() != 1) {
      throw VerifierErrors.InvalidInputs;
    }
    val (nextPayload, isExotic) = payload.loadRef().beginParseSpecial();
    if (isExotic || nextPayload.remainingBitsCount() < 257) {
      throw VerifierErrors.InvalidInputs;
    }
    payload = nextPayload;
  }
  return checkPublicInput(payload.loadInt(257));
}

fun finishGroth16(
  piA: slice,
  piB: slice,
  piC: slice,
  acc: slice,
  haveAcc: bool
): bool {
  // Final cpub = IC0 + acc (IC0 is always added exactly once)
  var cpub: slice;
  if (!haveAcc) {
    cpub = IC0;
  } else {
    cpub = blsG1Add(acc, IC0);
  }

  // Pairing check: e(cpub, gamma) * e(-piA, piB) * e(piC, delta) * e(alpha, beta) == 1
  val piANeg: slice = blsG1Neg(piA);
  val ok: int = blsPairing(
    cpub,         VK_GAMMA_2,
    piANeg,       piB,
    piC,          VK_DELTA_2,
    VK_ALPHA_1, VK_BETA_2,
    4
  );

  return ok != 0;
}

fun groth16VerifyPayload(
  piA: slice,
  piB: slice,
  piC: slice,
  mutate payload: slice
): bool {
  checkProofPoints(piA, piB, piC);

  // Compute: cpub = IC0 + sum(pubInputs[i] * IC(i+1))
  var haveAcc: bool = false;
  var acc: slice = IC0; // placeholder until haveAcc == true

  // Multiple 7-sized batches plus an optional tail.
  var done: int = 0;
  val full: int = N_PUBLIC / 7;
  val rem:  int = N_PUBLIC % 7;

  while (done < full * 7) {
    val y1: int = loadNextPubInput(mutate payload);
    val y2: int = loadNextPubInput(mutate payload);
    val y3: int = loadNextPubInput(mutate payload);
    val y4: int = loadNextPubInput(mutate payload);
    val y5: int = loadNextPubInput(mutate payload);
    val y6: int = loadNextPubInput(mutate payload);
    val y7: int = loadNextPubInput(mutate payload);
    val tmp: slice = blsG1Multiexp7(
      ic(done + 1), y1,
      ic(done + 2), y2,
      ic(done + 3), y3,
      ic(done + 4), y4,
      ic(done + 5), y5,
      ic(done + 6), y6,
      ic(done + 7), y7
      , 7
    );

    if (!haveAcc) {
      acc = tmp;
      haveAcc = true;
    } else {
      acc = blsG1Add(acc, tmp);
    }

    done += 7;
  }

  if (rem == 2) {
    val y1: int = loadNextPubInput(mutate payload);
    val y2: int = loadNextPubInput(mutate payload);
    val tail: slice = blsG1Multiexp2(
      ic(done + 1), y1,
      ic(done + 2), y2
      , 2
    );

    if (!haveAcc) {
      acc = tail;
      haveAcc = true;
    } else {
      acc = blsG1Add(acc, tail);
    }

    done += 2;
  }

  if (payload.remainingBitsCount() != 0 || payload.remainingRefsCount() != 0) {
    throw VerifierErrors.InvalidInputs;
  }

  return finishGroth16(piA, piB, piC, acc, haveAcc);
}

fun groth16VerifyArray(piA: slice, piB: slice, piC: slice, pubInputs: array<int>): bool {
  checkProofPoints(piA, piB, piC);
  if (pubInputs.size() != N_PUBLIC) { throw VerifierErrors.InvalidInputs; }

  // Compute: cpub = IC0 + sum(pubInputs[i] * IC(i+1))
  var haveAcc: bool = false;
  var acc: slice = IC0; // placeholder until haveAcc == true

  // Multiple 7-sized batches plus an optional tail.
  var done: int = 0;
  val full: int = N_PUBLIC / 7;
  val rem:  int = N_PUBLIC % 7;

  while (done < full * 7) {
    val tmp: slice = blsG1Multiexp7(
      ic(done + 1), checkPublicInput(pubInputs.get(done)),
      ic(done + 2), checkPublicInput(pubInputs.get(done + 1)),
      ic(done + 3), checkPublicInput(pubInputs.get(done + 2)),
      ic(done + 4), checkPublicInput(pubInputs.get(done + 3)),
      ic(done + 5), checkPublicInput(pubInputs.get(done + 4)),
      ic(done + 6), checkPublicInput(pubInputs.get(done + 5)),
      ic(done + 7), checkPublicInput(pubInputs.get(done + 6))
      , 7
    );

    if (!haveAcc) {
      acc = tmp;
      haveAcc = true;
    } else {
      acc = blsG1Add(acc, tmp);
    }

    done += 7;
  }

  if (rem == 2) {
    val tail: slice = blsG1Multiexp2(
      ic(done + 1), checkPublicInput(pubInputs.get(done)),
      ic(done + 2), checkPublicInput(pubInputs.get(done + 1))
      , 2
    );

    if (!haveAcc) {
      acc = tail;
      haveAcc = true;
    } else {
      acc = blsG1Add(acc, tail);
    }

    done += 2;
  }

  return finishGroth16(piA, piB, piC, acc, haveAcc);
}

/// Internal message containing Groth16 proof points and serialized public inputs.
struct (0x3b3cca17) Verify {
  /// Ordinary cell with exactly three refs: piA, piB, piC.
  proof: cell
  /// Ordinary cell with uint8 length followed by a linear int257 ref chain.
  pubInputs: cell
}

fun verifyProof(msg: Verify): bool {
  val (piA, piB, piC) = loadCheckedProof(msg.proof);
  val (initialPayload, payloadIsExotic) = msg.pubInputs.beginParseSpecial();
  var payload = initialPayload;

  if (payloadIsExotic || payload.remainingBitsCount() < 8) { throw VerifierErrors.InvalidInputs; }
  if (payload.loadUint(8) != N_PUBLIC) { throw VerifierErrors.InvalidInputs; }
  checkPublicInputsPayloadShape(payload);

  return groth16VerifyPayload(piA, piB, piC, mutate payload);
}

fun onInternalMessage(inMsg: InMessage) {
  val msg = lazy Verify.fromSlice(inMsg.body);

  match (msg) {
    Verify => {
      assert (inMsg.valueCoins >= MIN_VERIFY_VALUE) throw VerifierErrors.NotEnoughValue;
      val messageTail = msg.forceLoadLazyObject();
      if (!messageTail.isEmpty()) { throw VerifierErrors.InvalidInputs; }
      assert (verifyProof(msg)) throw VerifierErrors.WrongProof;
    }
    else => {
      assert (inMsg.body.isEmpty()) throw VerifierErrors.InvalidInputs;
    }
  }
}

/// Verifies a Groth16 proof against public inputs.
get fun verify(piA: slice, piB: slice, piC: slice, pubInputs: array<int>): bool {
  return groth16VerifyArray(piA, piB, piC, pubInputs);
}


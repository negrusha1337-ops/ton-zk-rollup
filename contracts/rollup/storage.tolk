// Хранилище rollup-контракта, протокол версии 2. Обоснования — PROTOCOL-V2.md.

/// Очередь L1→L2: депозиты и принудительные транзакции. Накопительный хеш
///   hash[i] = sha256(hash[i-1] ‖ получатель L2 ‖ сумма)                     для депозита,
///   hash[i] = sha256(hash[i-1] ‖ метка ‖ keccak256(байты транзакции EVM))   для принудительной транзакции
/// хранится в двух точках — head и processed, а для каждого ещё не убранного элемента в словаре
/// RollupState.queueItems лежит хеш очереди ДО него.
///
/// Батч сам заявляет, до какого элемента N он обработал очередь: processed ≤ N ≤ head и
/// N − processed ≤ MAX_BATCH_QUEUE_ITEMS. Хеш очереди в точке N контракт берёт у себя. Обязанности
/// обработать очередь к определённому батчу нет; цензуру ограничивает срок заморозки: если
/// самый старый необработанный элемент старше escapeTimeout, rollup замораживает кто угодно.
struct DepositQueue {
  /// Все поставленные элементы.
  headCount: uint64
  headHash: uint256
  /// Уже учтено в stateRoot.
  processedCount: uint64
  processedHash: uint256
  /// Записи словаря queueItems с номерами до этого включительно убраны. Не больше processedCount.
  prunedCount: uint64
}

/// Квитанция депозита: кому и сколько вернуть, если rollup заморожен раньше, чем
/// депозит обработан.
struct DepositReceipt {
  depositor: address
  amount: coins
}

/// Запись об элементе очереди L1. Ключ словаря — номер элемента, с единицы.
struct QueueEntry {
  /// Хеш очереди ДО этого элемента — то есть хеш в точке «обработано номер − 1 элементов».
  hashBefore: uint256
  /// Когда элемент встал в очередь: от него считается срок заморозки.
  queuedAt: uint32
  /// Квитанция — только у депозита: принудительной транзакции возвращать нечего.
  receipt: DepositReceipt?
}

/// Изменяемое состояние rollup'а — отдельная ячейка, перезаписывается каждым батчем.
struct RollupState {
  /// Слово состояния L2: хеш заголовка последнего принятого блока EVM.
  stateRoot: uint256
  /// Корень дерева выводов L2→L1 (накопительное дерево, глубина WITHDRAWAL_TREE_DEPTH).
  withdrawalsRoot: uint256
  /// Число листьев дерева выводов. Обязательно в публичных значениях: один корень счётчик
  /// не связывает (PROTOCOL-V2.md, раздел 4).
  withdrawalsCount: uint64
  batchIndex: uint64
  queue: Cell<DepositQueue>
  /// Данные батчей, опубликованные секвенсором, но ещё не закрытые пруфом:
  /// номер батча → накопительный хеш его порций,
  ///   hash[i] = sha256(hash[i-1] ‖ хеш ячейки с порцией), hash[-1] = 0.
  /// Сами данные контракт не хранит: они остаются в теле сообщения, то есть в блоке TON.
  /// Запись удаляется, когда батч принят. Обоснование — DA.md.
  pendingData: map<uint64, uint256>
  /// Элементы очереди L1, ещё не убранные: номер (с единицы) → запись. Записи с номерами
  /// больше processedCount нужны контракту (хеш очереди в точке N, срок заморозки, возврат
  /// депозита); с номерами до processedCount — мусор, его убирают постановка в очередь
  /// (до двух записей за раз) и сообщение PruneDepositReceipts.
  queueItems: map<uint64, QueueEntry>
  /// Аварийный режим включён: батчи и депозиты не принимаются, остаются выводы,
  /// возврат необработанных депозитов и выход счетов EVM по доказательству. Необратимо.
  frozen: bool
  /// Долги: заявки, уже погашенные в нуллификаторе, на выплату которых не хватило баланса.
  /// Ключ — ключ нуллификатора. Выплачиваются сообщением PayOwed. Пока баланс контракта
  /// покрывает его обязательства, словарь пуст. Гарантии такого покрытия нет: плата за
  /// хранение списывается с того же баланса, что и деньги пользователей, а пополняют его
  /// только комиссии депозитов и принудительных транзакций (ARCHITECTURE.md).
  owed: map<uint256, OwedPayout>
}

/// Невыплаченная заявка: кому и сколько.
struct OwedPayout {
  recipient: address
  amount: coins
}

/// Ключ верификации. Отдельная ячейка: у корневой не хватило бы ссылок.
struct RollupKeys {
  /// Собранный ключ программы батчей; null, пока не зафиксирован.
  vkData: cell?
  /// Части ключа на время загрузки.
  keyParts: map<uint8, cell>
}

/// Корневая ячейка. Редко меняющиеся поля и ссылки на всё остальное.
struct RollupStorage {
  /// Загружает и фиксирует ключ верификации.
  owner: address
  /// Единственный, кто может присылать батчи.
  sequencer: address
  /// Идентификатор rollup'а (как chainId в Ethereum). Задаётся при развёртывании и не
  /// меняется. Входит в публичный вход пруфа и в подпись каждой транзакции L2, поэтому
  /// пруф и транзакции одного rollup'а не подходят другому. Уникальность — на том, кто
  /// развёртывает: у двух rollup'ов с одним идентификатором и одним ключом защиты нет.
  chainId: uint64
  /// Сколько секунд необработанный элемент очереди может провисеть, прежде чем
  /// кто угодно сможет заморозить rollup (аварийный выход). Задаётся при развёртывании.
  escapeTimeout: uint32
  /// Наибольший возраст блока L2 на момент приёма батча, секунд: время блока обязано лежать
  /// в [now − maxBlockAge, now]. Задаётся при развёртывании; границы проверяет FinalizeKey.
  maxBlockAge: uint32
  keys: Cell<RollupKeys>
  /// Код дочернего контракта-нуллификатора выводов и аварийных выходов.
  nullifierCode: cell
  state: Cell<RollupState>
}

fun RollupStorage.load(): RollupStorage {
  return RollupStorage.fromCell(contract.getData());
}

fun RollupStorage.save(self) {
  contract.setData(self.toCell());
}

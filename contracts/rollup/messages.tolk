// Сообщения rollup-контракта (минимальная версия). Цепочки и поведение при
// bounce — в ARCHITECTURE.md.
import "../bn254/verifier_api"

/// То, что батч меняет. Остальные публичные значения пруфа (прежний корень, обе
/// отметки очереди депозитов и хеш опубликованных данных батча) контракт берёт из
/// своего хранилища, поэтому батч нельзя применить не к тому состоянию, нельзя
/// отправить повторно и нельзя доказать для данных, которых в TON не было.
struct BatchRoots {
  newStateRoot: uint256
  withdrawalsRoot: uint256
}

/// Секвенсор → Rollup: новый батч с доказательством.
///
/// Нонса SP1 (пятого публичного входа его верификатора) в сообщении нет намеренно: он
/// равен нулю и свёрнут в ключ вместе с остальными постоянными входами. Так у пруфа один
/// переменный вход, а у ключа — одна оконная таблица; вторую пришлось бы принимать на веру,
/// потому что ни один пруф с нулевым нонсом её не задействует.
struct (0x52420001) SubmitBatch {
  queryId: uint64
  proof: Cell<ProofPoints>
  /// Свидетель, наклоны, аккумуляторы и частное (zk/bn254-hints.mjs).
  hints: cell
  roots: Cell<BatchRoots>
}

/// Секвенсор → Rollup: порция данных батча (data availability). Контракт не читает
/// содержимое — только хеш ячейки, который сеть уже посчитала. Порции одного батча
/// складываются в накопительный хеш в порядке прихода; программа zkVM обязана
/// разобрать и исполнить ровно их.
///
/// Форму ячейки контракт не проверяет. Порцию, разложенную не так, как ждёт программа
/// (dataChunkCell в wrappers/rollupMath.ts), длиннее 60 000 байт или экзотическую,
/// программа не воспроизведёт, и батч с ней не доказать — тогда секвенсор сбрасывает
/// данные батча сообщением DiscardBatchData и публикует заново.
struct (0x52420003) PublishData {
  queryId: uint64
  /// Номер батча, которому принадлежит порция: ещё не принятого и не дальше чем на
  /// MAX_DATA_BATCHES_AHEAD от последнего принятого.
  batchIndex: uint64
  data: cell
}

/// Секвенсор → Rollup: забыть всё, что опубликовано для ещё не принятого батча. Нужен,
/// чтобы ошибка публикации (лишняя или неверно собранная порция) не останавливала rollup:
/// без сброса накопительный хеш исправить нельзя. Сами сообщения остаются в блоках TON.
struct (0x5242000b) DiscardBatchData {
  queryId: uint64
  batchIndex: uint64
}

/// Пользователь → Rollup: депозит TON. Сумма депозита = приложенные монеты минус комиссия
/// за место в очереди. Комиссия — DEPOSIT_FEE, пока очередь коротка, и удваивается на каждые
/// QUEUE_FEE_STEP элементов, ждущих в текущем окне (get-метод queueFees).
struct (0x52420002) DepositTon {
  queryId: uint64
  /// Получатель на L2 (EVM-адрес).
  l2Recipient: uint160
  /// Наибольшая комиссия, на которую согласен вноситель. Комиссия вычитается из суммы,
  /// зачисляемой на L2, поэтому без этой границы перегруженная очередь молча уменьшила бы
  /// депозит. Если текущая комиссия выше — депозит возвращается отправителю целиком.
  maxFee: coins
}

/// Кто угодно → Rollup: поставить транзакцию L2 в очередь L1 в обход секвенсора.
/// Секвенсор обязан обработать очередь по порядку, а элемент, провисевший дольше
/// escapeTimeout, позволяет заморозить rollup — так закрывается выборочная цензура.
/// Содержимое контракт не разбирает: программа zkVM исполнит транзакцию, если она
/// корректна и подписана владельцем счёта, и пропустит иначе.
struct (0x52420005) ForceTransaction {
  queryId: uint64
  /// Байты одной подписанной транзакции L2: одна ячейка без ссылок, целое число байт.
  l2Transaction: cell
}

/// Кто угодно → Rollup: вывод по Merkle-доказательству против withdrawalsRoot.
/// Деньги уходят получателю из листа, газ платит отправитель сообщения.
struct (0x52420004) Withdraw {
  queryId: uint64
  leafIndex: uint32
  /// Получатель в basechain.
  recipient: address
  amount: coins
  /// Хеши-соседи от листа к корню, по три uint256 на ячейку, продолжение по ссылке.
  merkleProof: cell
}

/// Rollup → Nullifier(leafIndex): пометить вывод использованным.
struct (0x52420010) NullifierClaim {
  queryId: uint64
  recipient: address
  amount: coins
}

/// Nullifier → Rollup: вывод помечен впервые, можно платить.
struct (0x52420011) NullifierClaimed {
  queryId: uint64
  key: uint256
  recipient: address
  amount: coins
}

/// Кто угодно → Rollup: выплатить долг по уже погашенной заявке. Долг появляется, если в
/// момент подтверждения от нуллификатора у контракта не хватило баланса: пометка в
/// нуллификаторе уже стоит и снять её нельзя, поэтому выплата не теряется, а записывается
/// (RollupState.owed) и ждёт денег. Получатель и сумма берутся из записи, не из сообщения.
struct (0x5242000c) PayOwed {
  queryId: uint64
  /// Ключ нуллификатора: номер листа дерева выводов или ключ аварийного выхода.
  key: uint256
}

/// Владелец → Rollup: IC0 ключа программы выхода. Задаётся один раз, до фиксации ключа.
struct (0x52420009) SetExitKey {
  queryId: uint64
  ic0x: uint254
  ic0y: uint254
}

/// Кто угодно → Rollup: заморозить rollup, если самый старый необработанный депозит
/// провисел в очереди дольше escapeTimeout.
struct (0x52420006) ActivateEscapeHatch {
  queryId: uint64
}

/// Что выводит владелец счёта L2 при аварийном выходе.
struct ExitClaim {
  l2Account: uint160
  amount: uint128
  /// Получатель в basechain.
  recipient: address
}

/// Кто угодно → Rollup (только после заморозки): выплатить баланс счёта L2 из последнего
/// принятого состояния. Пруф — программы выхода (zkvm/exit-program): счёт с таким балансом
/// есть в состоянии, и его владелец подписал этого получателя.
struct (0x52420007) ForceExit {
  queryId: uint64
  proof: Cell<ProofPoints>
  hints: cell
  claim: Cell<ExitClaim>
}

/// Кто угодно → Rollup (только после заморозки): вернуть вносителю депозит, который не
/// успел попасть в батч.
struct (0x52420008) CancelDeposit {
  queryId: uint64
  /// Номер депозита в очереди, с единицы.
  depositIndex: uint64
}

/// Кто угодно → Rollup: удалить квитанции уже обработанных депозитов (не больше count).
struct (0x5242000a) PruneDepositReceipts {
  queryId: uint64
  count: uint16
}

type RollupMessage =
  | SubmitBatch
  | PublishData
  | DiscardBatchData
  | PayOwed
  | DepositTon
  | ForceTransaction
  | Withdraw
  | NullifierClaimed
  | UploadKeyPart
  | FinalizeKey
  | SetExitKey
  | ActivateEscapeHatch
  | ForceExit
  | CancelDeposit
  | PruneDepositReceipts
